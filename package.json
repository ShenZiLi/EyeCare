{
  "name": "eyecare",
  "productName": "EyeCare",
  "version": "1.0.4",
  "description": "跨平台常驻护眼提醒工具",
  "author": "EyeCare contributors",
  "license": "MIT",
  "scripts": {
    "start": "npm run tauri:dev --",
    "vite:dev": "vite --config vite.renderer.config.ts --port 5173 --strictPort",
    "vite:build": "vite build --config vite.renderer.config.ts",
    "tauri:dev": "mise exec -- npx tauri dev",
    "tauri:build": "mise exec -- npx tauri build",
    "package": "npm run tauri:build -- --no-bundle",
    "make": "npm run tauri:build --",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app tests *.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run test:rust",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:rust",
    "build": "npm run tauri:build --",
    "test:rust": "mise exec -- cargo test --locked --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "24.7.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.37.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
